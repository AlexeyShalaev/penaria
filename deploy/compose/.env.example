# Copy to .env and fill in. Docker Compose reads .env from this folder by itself.

# The address people will open, exactly as they type it: the root of a site, no path.
# At home without a domain: http://<this machine's address>:8080 (passkeys then stay off:
# browsers allow them only on https with a host name, or on localhost).
PENARIA_PUBLIC_URL=http://localhost:8080

# Encrypts stored secrets. Make one with `openssl rand -hex 32`, keep it, and back it up
# apart from the database: without it the mailbox's password and authenticator apps are lost.
PENARIA_SECRET_KEY=

# The database's password, used only inside this install. `openssl rand -hex 24` makes one.
# It is set when the database is first created; changing it here later does not change it there.
POSTGRES_PASSWORD=

# The password of the file storage, used only inside this install. `openssl rand -hex 24` makes one.
S3_PASSWORD=

# The largest file people can add, in bytes (50 MB unless set).
#PENARIA_FILES__MAX_SIZE=52428800

# The port of the web app on this machine (without compose.https.yaml).
#PENARIA_PORT=8080

# With compose.https.yaml: the host name of PENARIA_PUBLIC_URL, such as home.example.org.
#PENARIA_DOMAIN=
