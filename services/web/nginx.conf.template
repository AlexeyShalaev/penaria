# Rendered when the container starts: the image's entrypoint substitutes
# ${PENARIA_API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} and writes the result to conf.d.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # The API is served from the same origin as the app, so the session cookie and the
    # origin check need no cross-site rules. The upstream is resolved per request: nginx
    # starts, and serves the app, even while the server is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $penaria_api ${PENARIA_API_UPSTREAM};

    location /api/ {
        proxy_pass $penaria_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # One address, never the header the client sent: the server limits sign-in attempts
        # by it. Behind another proxy, PENARIA_TRUSTED_PROXIES makes this the visitor's own.
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Hashed assets never change: cache them for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the app shell, which is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
